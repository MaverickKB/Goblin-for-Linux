{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goblin",
  "version": "0.1.0",
  "identifier": "com.maverickkb.goblin",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goblin",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": [
      "../Runtime",
      "../Resources",
      "../product.json",
      "../scripts/goblin-credentials"
    ],
    "shortDescription": "A native Linux agent companion",
    "longDescription": "Goblin is a desktop agent companion with local tools, persistent history, embedded AetherMind continuity, and an autonomy floor whose on switch belongs to the operator."
  }
}
