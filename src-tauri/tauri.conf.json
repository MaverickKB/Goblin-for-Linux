{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goblin",
  "version": "0.1.1",
  "identifier": "com.maverickkb.goblin",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goblin",
        "width": 898,
        "height": 674,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": [
      "../Runtime",
      "../Resources",
      "../product.json",
      "../scripts/goblin-credentials",
      "../scripts/goblin-credentials.py",
      "../vendor/python"
    ],
    "shortDescription": "A native Linux agent companion",
    "longDescription": "Goblin is a desktop agent companion with local tools, persistent history, embedded AetherMind continuity, and an autonomy floor whose on switch belongs to the operator."
  }
}
